+/// 使用由目录能力读取的字节替换智能对象，保留变换、蒙版和滤镜。
+/// 不访问环境文件系统；重新链接收集策略同样输出嵌入内容。
+pub fn replace_scoped_bytes(s: &mut Session, p: &Value, name: &str, bytes: Vec<u8>) -> Result<Value> {
+    decode_source(name, &bytes)?;
+    let name = base_name(name);
+    set_source(s, p, "Replace Collected Contents", false, |_, _| Ok(SmartSource::Embedded { file_name: name, bytes: Arc::new(bytes) }))
+}
+
+/// 验证收集对象已经嵌入；拒绝读取原工程中的环境链接。
+pub fn verify_scoped_embedded(s: &mut Session, p: &Value) -> Result<Value> {
+    let id = layer_param(s, p)?;
+    let doc = &s.active().ok_or(EngineError::NoDocument)?.doc;
+    if !matches!(smart(doc, id)?.source, SmartSource::Embedded { .. }) {
+        return Err(other("scoped linked content must be replaced with registered bytes before embedding"));
+    }
+    Ok(json!({"layer": id.0, "embedded": true}))
 }
 
