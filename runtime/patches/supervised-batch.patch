+/// 在批处理写目录或打开文件前确认完整清单；每个文件仍使用独立原生会话。
+/// 参数为原始标志及输出通道；返回整批已确认或当前失败，不继续其他文件。
+fn batch_supervised(a: &Args, out: &mut dyn Write, err: &mut dyn Write) -> R {
+    let actions_path = a.get("--actions").ok_or("batch needs --actions <file>")?;
+    let in_raw = a.get("--in").ok_or("batch needs --in <dir>")?;
+    let out_raw = a.get("--out").ok_or("batch needs --out <dir>")?;
+    let in_dir = PathBuf::from(in_raw);
+    let out_dir = PathBuf::from(out_raw);
+    let text = std::fs::read_to_string(actions_path).map_err(|e| format!("{actions_path}: {e}"))?;
+    let actions = parse_actions(&text)?;
+    let opts = export_opts(a)?;
+    let mut inputs: Vec<PathBuf> = std::fs::read_dir(&in_dir)
+        .map_err(|e| format!("{}: {e}", in_dir.display()))?
+        .flatten().map(|entry| entry.path()).filter(|path| is_input(path)).collect();
+    inputs.sort();
+    let planned: Vec<(PathBuf, PathBuf, String)> = inputs.into_iter().map(|input| {
+        let ext = a.get("--format").map(str::to_owned)
+            .or_else(|| input.extension().map(|e| e.to_string_lossy().into_owned())).unwrap_or_else(|| "png".into());
+        let stem = input.file_stem().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+        let target = out_dir.join(format!("{stem}.{ext}"));
+        (input, target, ext)
+    }).collect();
+    let files: Vec<Value> = planned.iter().map(|(input, target, _)| json!({"input": input, "target": target})).collect();
+    let steps: Vec<Value> = actions.iter().map(|(id, params)| json!({"id": id, "params": params})).collect();
+    let mut config = json!({"actions": actions_path, "in": in_raw, "out": out_raw});
+    if let Some(format) = a.get("--format") { config["format"] = json!(format); }
+    if a.get("--quality").is_some() { config["quality"] = json!(opts.encode.jpeg_quality); }
+    let stdin = std::io::stdin();
+    let mut input = stdin.lock();
+    let mut sequence = 0;
+    supervised_result(a, &mut input, out, &mut sequence, "batch_plan", config,
+        Ok(json!({"files": files, "steps": steps})), false)?;
+    std::fs::create_dir_all(&out_dir).map_err(|error| error.to_string())?;
+    for (source, target, ext) in &planned {
+        let mut h = Headless::trusted_local();
+        let result = h.open(source).map_err(|error| error.to_string());
+        supervised_result(a, &mut input, out, &mut sequence, "doc_open", json!({"path": source}), result, false)?;
+        for (id, params) in &actions {
+            let result = h.command_run(id, params.clone()).map_err(|error| format!("`{id}`: {error}"));
+            supervised_result(a, &mut input, out, &mut sequence, "command_run",
+                json!({"id": id, "params": params}), result, false)?;
+        }
+        let result = h.save(None, Some(target), Some(ext), &opts).map_err(|error| error.to_string());
+        let mut arguments = json!({"path": target, "format": ext});
+        if a.get("--quality").is_some() { arguments["quality"] = json!(opts.encode.jpeg_quality); }
+        let result = supervised_result(a, &mut input, out, &mut sequence, "doc_save", arguments, result, false)?;
+        let warnings: Vec<String> = serde_json::from_value(result["warnings"].clone()).unwrap_or_default();
+        warn_all(err, &warnings);
+    }
+    supervised_result(a, &mut input, out, &mut sequence, "batch_complete", json!({}),
+        Ok(json!({"succeeded": planned.len(), "failed": 0})), false)?;
+    Ok(())
+}
