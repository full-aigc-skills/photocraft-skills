+/// 将当前原生结果交给监督者；明确确认之前不运行下一项命令。
+/// 参数包含工具身份、原请求和当前结果；返回已确认结果或停止错误。
+fn supervised_result(
+    a: &Args, input: &mut dyn BufRead, out: &mut dyn Write, sequence: &mut u64,
+    tool: &str, arguments: Value, result: Result<Value, String>, visible: bool,
+) -> Result<Value, String> {
+    if !a.has("--supervised") {
+        return result;
+    }
+    *sequence += 1;
+    let mut event = json!({"schema": "photocraft-supervised-run/v1", "sequence": *sequence,
+        "tool": tool, "arguments": arguments, "visible": visible});
+    match &result {
+        Ok(value) => event["result"] = value.clone(),
+        Err(error) => event["error"] = json!(error),
+    }
+    print_json(out, &event, true)?;
+    out.flush().map_err(|error| error.to_string())?;
+    let value = result?;
+    // 固定 ASCII 确认帧不依赖 JSON 宽松解析；序号不符、EOF及超长输入均停止。
+    let mut confirmation = Vec::new();
+    input.take(4097).read_until(b'\n', &mut confirmation).map_err(|error| error.to_string())?;
+    if confirmation != format!("continue {}\n", *sequence).as_bytes() {
+        return Err("supervised result not acknowledged; operation may have completed; do not replay".into());
+    }
+    Ok(value)
+}
